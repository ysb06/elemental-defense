  displayName: "\uB545\uC758 \uC815\uB839 \uD1A0\uB974\uD06C"
  story: "\uD1A0\uB974\uD06C\uB294 \uCC9C \uB144 \uB3D9\uC548 \uB9C8\uC744\uC758
    \uACBD\uACC4\uB97C \uC9C0\uCF1C\uC628 \uACE0\uB300 \uC218\uD638\uBC14\uC704\uC5D0\uC11C
    \uAE68\uC5B4\uB09C \uB545\uC758 \uC815\uB839\uC774\uB2E4. \uC624\uB79C \uC138\uC6D4
    \uBE44\uC640 \uBC14\uB78C\uC744 \uB9D0\uC5C6\uC774 \uACAC\uB518 \uD0D3\uC5D0
    \uB9D0\uC218\uB294 \uC801\uACE0 \uD45C\uC815\uB3C4 \uBB34\uB69D\uB69D\uD558\uC9C0\uB9CC,
    \uC791\uC740 \uD480 \uD55C \uD3EC\uAE30\uAC00 \uBC1F\uD788\uB294 \uAC83\uC870\uCC28
    \uADF8\uB0E5 \uC9C0\uB098\uCE58\uC9C0 \uBABB\uD560 \uB9CC\uD07C \uC0DD\uBA85\uC744
    \uC18C\uC911\uD788 \uC5EC\uAE34\uB2E4. \uACFC\uAC70 \uAC70\uB300\uD55C \uC0B0\uC0AC\uD0DC\uAC00
    \uB9C8\uC744\uC744 \uB36E\uCCE4\uC744 \uB54C \uD1A0\uB974\uD06C\uB294 \uC790\uC2E0\uC758
    \uB4F1\uACFC \uD314\uC744 \uC0B0\uAE30\uC2AD\uC5D0 \uBC15\uC544 \uBB34\uB108\uC9C0\uB294
    \uB545\uC744 \uBA48\uCDC4\uACE0, \uADF8 \uCDA9\uACA9\uC73C\uB85C \uAE30\uC5B5\uC758
    \uC77C\uBD80\uC640 \uBAB8\uC744 \uC774\uB8E8\uB358 \uD575\uC2EC\uC11D\uC744 \uC783\uC5C8\uB2E4.
    \uC774\uD6C4 \uB4F1\uC5D0 \uB3CB\uC740 \uC218\uC815 \uAC00\uC2DC\uB294 \uB545\uC18D\uC758
    \uC9C4\uB3D9\uACFC \uC704\uD5D8\uC744 \uAC10\uC9C0\uD558\uB294 \uB098\uCE68\uBC18\uC774
    \uB418\uC5C8\uC73C\uBA70, \uBA40\uB9AC \uB5A8\uC5B4\uC9C4 \uB3D9\uB8CC\uC758
    \uBC1C\uAC78\uC74C\uB3C4 \uC54C\uC544\uCC4C \uC218 \uC788\uAC8C \uB418\uC5C8\uB2E4.
    \uC804\uD22C\uC5D0\uC11C\uB294 \uAC00\uC7A5 \uC55E\uC5D0 \uC11C\uC11C \uACF5\uACA9\uC744
    \uBC1B\uC544\uB0B4\uACE0, \uBC14\uC704\uBCBD\uACFC \uB3CC\uAE30\uB465\uC744 \uC19F\uAD6C\uCE58\uAC8C
    \uD574 \uBAA8\uB450\uAC00 \uC548\uC804\uD558\uAC8C \uC2F8\uC6B8 \uAE38\uC744
    \uB9CC\uB4E0\uB2E4. \uAC89\uC73C\uB85C\uB294 \uD50C\uB808\uC624\uC758 \uC18C\uB780\uACFC
    \uB9AC\uB8E8\uC758 \uC7A5\uB09C\uC744 \uADC0\uCC2E\uC544\uD558\uC9C0\uB9CC, \uB450
    \uC815\uB839\uC774 \uC7A0\uB4E4\uBA74 \uBC24\uC0C8 \uC8FC\uBCC0\uC744 \uC9C0\uD0A4\uB294
    \uB4E0\uB4E0\uD55C \uB9CF\uD615\uC774\uB2E4. \uD1A0\uB974\uD06C\uB294 \uD769\uC5B4\uC9C4
    \uD575\uC2EC\uC11D \uC870\uAC01\uC744 \uB418\uCC3E\uACE0, \uB545 \uC544\uB798\uC5D0\uC11C
    \uB2E4\uC2DC \uB6F0\uAE30 \uC2DC\uC791\uD55C \uC815\uCCB4\uBD88\uBA85\uC758 \uAC70\uB300\uD55C
    \uC2EC\uC7A5\uC774 \uB9C8\uC744\uC744 \uAE68\uC6B0\uAE30 \uC804\uC5D0 \uC790\uC2E0\uC758
    \uC78A\uD78C \uC0AC\uBA85\uC744 \uBC1D\uD600\uB0B4\uC57C \uD55C\uB2E4."
  cost: 1
  skill: {fileID: 11400000, guid: 61f4f96951aed4827aa6457b7ab4f04d, type: 2}
