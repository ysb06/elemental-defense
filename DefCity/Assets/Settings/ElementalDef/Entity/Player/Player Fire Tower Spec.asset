  displayName: "\uBD88\uC758 \uC815\uB82C \uD50C\uB808\uC624"
  story: "\uD50C\uB808\uC624\uB294 \uD654\uC0B0 \uC2EC\uC7A5\uBD80\uC758 \uC624\uB798\uB41C
    \uB300\uC7A5\uAC04\uC5D0\uC11C \uBD88\uAF43\uACFC \uC1F3\uC18C\uB9AC\uAC00 \uB4A4\uC11E\uC774\uB358
    \uC21C\uAC04 \uD0DC\uC5B4\uB09C \uBD88\uC758 \uC815\uB839\uC774\uB2E4. \uCC98\uC74C
    \uC138\uC0C1\uC5D0 \uB098\uC654\uC744 \uB54C \uADF8\uB294 \uBD88\uAE38\uC744
    \uC870\uC808\uD558\uC9C0 \uBABB\uD574 \uC232 \uAC00\uC7A5\uC790\uB9AC\uB97C \uD0DC\uC6CC
    \uBC84\uB838\uACE0, \uC790\uC2E0\uC744 \uB450\uB824\uC6CC\uD558\uB294 \uC774\uB4E4\uC758
    \uC2DC\uC120\uC744 \uD53C\uD574 \uC624\uB7AB\uB3D9\uC548 \uC6A9\uC554 \uB3D9\uAD74\uC5D0
    \uC228\uC5B4 \uC9C0\uB0C8\uB2E4. \uADF8\uB7EC\uB098 \uB9C8\uBB3C \uB5BC\uAC00
    \uC778\uADFC \uB9C8\uC744\uC744 \uC2B5\uACA9\uD55C \uB0A0, \uD50C\uB808\uC624\uB294
    \uB3C4\uB9DD\uCE58\uC9C0 \uC54A\uACE0 \uD769\uC5B4\uC9C0\uB358 \uBD88\uAF43\uC744
    \uB450 \uC8FC\uBA39\uC5D0 \uBAA8\uC544 \uC0AC\uB78C\uB4E4\uC744 \uC9C0\uCF1C\uB0C8\uB2E4.
    \uADF8 \uC77C\uC744 \uD1B5\uD574 \uADF8\uB294 \uBD88\uC774 \uD30C\uAD34\uB9CC\uC744
    \uC704\uD55C \uD798\uC774 \uC544\uB2C8\uB77C \uCD94\uC704\uB97C \uBAB0\uC544\uB0B4\uACE0,
    \uC5B4\uB460\uC744 \uBC1D\uD788\uBA70, \uBD80\uC11C\uC9C4 \uB3C4\uAD6C\uB97C
    \uB2E4\uC2DC \uBCBC\uB9AC\uB294 \uD798\uC784\uC744 \uAE68\uB2EC\uC558\uB2E4.
    \uC131\uACA9\uC740 \uAE09\uD558\uACE0 \uC2B9\uBD80\uC695\uC774 \uAC15\uD574 \uB9AC\uB8E8\uC640
    \uC790\uC8FC \uD2F0\uACA9\uD0DC\uACA9\uD558\uC9C0\uB9CC, \uC704\uD5D8\uD55C \uC21C\uAC04\uC5D0\uB294
    \uB204\uAD6C\uBCF4\uB2E4 \uBA3C\uC800 \uB3D9\uB8CC \uC55E\uC744 \uAC00\uB85C\uB9C9\uB294
    \uB728\uAC70\uC6B4 \uC758\uB9AC\uC758 \uC18C\uC720\uC790\uB2E4. \uC9C0\uAE08
    \uD50C\uB808\uC624\uB294 \uC0AC\uB77C\uC9C4 \uC2A4\uC2B9\uC774 \uB0A8\uAE34 \uB2E8\uC11C\uC640
    \uC804\uC124\uC758 \u2018\uD0DC\uCD08\uC758 \uBD88\uC528\u2019\uB97C \uCC3E\uC544
    \uC5EC\uD589 \uC911\uC774\uB2E4. \uC5B8\uC820\uAC00 \uC790\uC2E0\uC758 \uD798\uC744
    \uC644\uC804\uD788 \uB2E4\uC2A4\uB824, \uB9C8\uC744 \uD55C\uAC00\uC6B4\uB370
    \uB204\uAD6C\uB3C4 \uCD94\uC704\uC5D0 \uB5A8\uC9C0 \uC54A\uB294 \uAEBC\uC9C0\uC9C0
    \uC54A\uB294 \uD654\uB85C\uB97C \uB9CC\uB4DC\uB294 \uAC83\uC774 \uADF8\uC758
    \uAFC8\uC774\uB2E4."
  cost: 1
  skill: {fileID: 11400000, guid: 61f4f96951aed4827aa6457b7ab4f04d, type: 2}
